#include <iostream>

using namespace std;

typedef void (*Command)(int&, int);

void deposit(int& balance, int k) {
    if (k <= 0) {
        cout << "error\n";
        return;
    }
    balance += k;
}

void withdraw(int& balance, int k) {
    if (k <= 0 || k > balance) {
        cout << "error\n";
        return;
    }
    balance -= k;
}

void balanceCmd(int& balance, int k) {
    cout << balance << '\n';
}

void reset(int& balance, int k) {
    balance = 0;
}

void inc(int& balance, int k) {
    ++balance;
}

int main() {
    const char* names[] = {"deposit", "withdraw", "balance", "reset", "inc"};
    Command funcs[] = {deposit, withdraw, balanceCmd, reset, inc};
    const int N = 5;

    int balance = 0;
    char cmd[64];

    while (cin >> cmd) {
        if (same(cmd, "stop")) {
            break;
        }

        bool found = false;
        for (int i = 0; i < N; ++i) {
            if (same(cmd, names[i])) {
                int k = 0;
                if (same(cmd, "deposit") || same(cmd, "withdraw")) {
                    cin >> k;
                }
                funcs[i](balance, k);
                found = true;
                break;
            }
        }

        if (!found) {
            cout << "error\n";
        }
    }

    return 0;
}
