// ==================== EXCEPTIONS ====================

class FleetError : public exception {
protected:
    string message;

public:
    explicit FleetError(const string& msg) : message(msg) {}
    const char* what() const noexcept override {
        return message.c_str();
    }
};

class InspectionRejected : public FleetError {
public:
    InspectionRejected() : FleetError("inspection rejected") {}
};

class CommandError : public FleetError {
public:
    explicit CommandError(const string& msg) : FleetError(msg) {}
};

// ==================== MODEL SPECIFICATION ====================

class ModelSpec {
public:
    string modelName;
    explicit ModelSpec(const string& name) : modelName(name) {}
};

// ==================== INVENTORY ====================

class InventoryItem {
protected:
    string id;
    string itemName;

public:
    InventoryItem(const string& id, const string& name) : id(id), itemName(name) {
        if (id.empty()) {
            throw CommandError("empty inventory id");
        }
        if (name.empty()) {
            throw CommandError("empty name");
        }
    }

    virtual ~InventoryItem() = default;
    virtual string inventoryId() const {
        return id;
    }
    virtual string name() const {
        return itemName;
    }
    virtual string describe() const = 0;
    friend ostream& operator<<(ostream& out, const InventoryItem& item) {
        out << item.inventoryId() << " " << item.name();
        return out;
    }
    bool operator<(const InventoryItem& other) const {
        return inventoryId() < other.inventoryId();
    }
};

// ==================== ENERGY CONSUMER ====================

class EnergyConsumer {
public:
    virtual ~EnergyConsumer() = default;
    virtual double dailyEnergy() const = 0;
};

// ==================== TRANSPORT ====================

class Transport : public virtual InventoryItem {
protected:
    int simplicity;
    shared_ptr<ModelSpec> specification;

public:
    Transport(const string& id, const string& name, int score, shared_ptr<ModelSpec> spec)
        : InventoryItem(id, name), simplicity(score), specification(move(spec)) {
        if (score < 1 || score > 10) {
            throw CommandError("simplicity must be from 1 to 10");
        }
    }
    bool suitableForNovice() const {
        return simplicity >= 6;
    }
    virtual ~Transport() = default;
    string describe() const override {
        return itemName;
    }
};

// ==================== ELECTRIC SCOOTER ====================

class ElectricScooter : public Transport, public EnergyConsumer {
private:
    double energy;

public:
    ElectricScooter(const string& id, const string& name, double energy, int score, shared_ptr<ModelSpec> spec)
        : InventoryItem(id, name), Transport(id, name, score, move(spec)), energy(energy) {
        if (energy < 0) {
            throw CommandError("negative energy");
        }
    }
    double dailyEnergy() const override {
        return energy;
    }
};

